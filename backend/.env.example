ENVIRONMENT=development

# Point this at PostgreSQL in staging/production, e.g.:
# DATABASE_URL=postgresql+psycopg2://eval_user:eval_pass@localhost:5432/eval_db
DATABASE_URL=sqlite:///./dev.db

JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Bootstrap administrator. This address is seeded into the approved-email list so the
# first sign-in is possible; every other user is approved from the Judges & access page.
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrator

# One-time passcode sign-in
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# SMTP delivery for passcodes.
# LEAVE SMTP_HOST BLANK ONLY IN LOCAL DEVELOPMENT: with no mail server configured the
# passcode is written to the server log AND returned in the sign-in API response, which
# means anyone who can reach the API can sign in as any approved address. Always set
# SMTP_HOST before exposing this to a network.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@your-domain.com
SMTP_FROM_NAME=Hackathon Evaluation Platform

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=300

DEFAULT_DISAGREEMENT_THRESHOLD=1.5

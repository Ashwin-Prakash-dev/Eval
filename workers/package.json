{
  "name": "eval-workers-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dryrun": "wrangler deploy --dry-run --outdir=.wrangler/dryrun",
    "db:migrate:local": "wrangler d1 migrations apply eval-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply eval-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
